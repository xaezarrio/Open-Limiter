[Version]
Signature = "$WINDOWS NT$"
Class = System
ClassGuid = {4d36e97d-e325-11ce-bfc1-08002be10318}
Provider = %ProviderName%
DriverVer = 09/26/2026,0.4.0.0
CatalogFile = OpenLimiter.Wfp.cat
PnpLockdown = 1

[DestinationDirs]
OpenLimiterWfp.CopyFiles = 13

[DefaultInstall.NTamd64]
CopyFiles = OpenLimiterWfp.CopyFiles

[DefaultInstall.NTamd64.Services]
AddService = OpenLimiterWfp,,OpenLimiterWfp.Service

[OpenLimiterWfp.CopyFiles]
OpenLimiter.Wfp.sys

[OpenLimiterWfp.Service]
DisplayName = %ServiceDisplayName%
Description = %ServiceDescription%
ServiceBinary = %13%\OpenLimiter.Wfp.sys
ServiceType = 1
StartType = 3
ErrorControl = 1

[SourceDisksNames]
1 = %DiskName%,,,

[SourceDisksFiles]
OpenLimiter.Wfp.sys = 1

[Strings]
ProviderName = "OpenLimiter contributors"
ServiceDisplayName = "OpenLimiter WFP Driver"
ServiceDescription = "Pass-through Windows Filtering Platform callout driver for OpenLimiter."
DiskName = "OpenLimiter WFP Driver installation media"
